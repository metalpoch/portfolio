---
interface Props {
  title: string;
  view: string;
}
import ShootingStars from "../components/ShootingStars.astro";
import Navigator from "../components/Navigator.astro";
import { ViewTransitions } from "astro:transitions";

const { title, view } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Keiber Urbila Portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <ShootingStars />
    <main transition:animate="slide">
      <slot />
    </main>
    <footer>
      <img
        class="player"
        alt="Keiber as pixel art"
        src="/assets/KeiberUrbila.webp"
      />
      <Navigator disable={view} />
    </footer>

    <style is:global>
      *,
      *:after,
      *:before {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        text-decoration: none;
        list-style: none;
      }

      @font-face {
        font-family: retroGaming;
        src: url(/fonts/retroGaming.ttf);
      }

      body {
        font-size: 100%;
        list-style-type: none;
        background: url("/assets/bg.webp"),
          linear-gradient(
            0deg,
            rgba(255, 143, 0, 1) 0%,
            rgba(82, 109, 148, 1) 24%
          );
        background-repeat: repeat-x;
        background-attachment: fixed;
        background-position: bottom left;
        background-size: 240vh;
      }

      p {
        margin-bottom: 0;
        color: #444;
        opacity: 0.8;
        padding: 0.5em 0.5em 0.5em 0.5em;
        font-size: 1.25em;
      }

      a {
        text-decoration: underline;
        font-weight: bold;
      }

      h1 {
        text-align: center;
        margin: 0;
        color: #000;
        font-size: 1.5em;
        transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }

      html {
        font-family: retroGaming, system-ui, sans-serif;
      }

      .highlighter {
        color: #ae0e9e;
        font-weight: bold;
      }

      main {
        display: flex;
        height: 50vh;
        flex-direction: column;
        padding: 1em;
      }

      footer {
        display: flex;
        height: 50vh;
      }

      .player {
        height: 50vh;
        object-fit: cover;
      }

      @media (max-width: 575.98px) {
        footer {
          position: fixed;
          padding: 1em;
          width: 100%;
        }
        .player {
          height: 35vh;
          object-fit: cover;
        }
        .title {
          font-size: 2em;
          margin-bottom: 1em;
        }
        .text {
          text-align: justify;
          text-justify: distribute;
          font-size: 1.3em;
          color: #e7e7e7;
        }
      }
    </style>
  </body>
</html>
