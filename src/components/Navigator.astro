---
interface Props {
  disable: string;
}

import ThreadsIcon from "./ThreadsIcon.astro";
import LinkedinIcon from "./LinkedinIcon.astro";
import InstagramIcon from "./InstagramIcon.astro";
import GithubIcon from "./GithubIcon.astro";
import ConsoleIcon from "./ConsoleIcon.astro";
import GalleryIcon from "./GalleryIcon.astro";
import ExpIcon from "./ExpIcon.astro";
import SkillsIcon from "./SkillsIcon.astro";
import ProfileIcon from "./ProfileIcon.astro";
const { disable } = Astro.props;
---

<nav>
  <a href="/" class={`link ${disable === "about" && "hide"}`}
    >About
    <ProfileIcon />
  </a>
  <a href="/skills" class={`link ${disable === "skills" && "hide"}`}
    >Skills
    <SkillsIcon />
  </a>
  <a href="/exp" class={`link ${disable === "exp" && "hide"}`}
    >Exp
    <ExpIcon />
  </a>
  <a href="/gallery" class={`link ${disable === "gallery" && "hide"}`}
    >Gallery
    <GalleryIcon />
  </a>

  <a href="/projects" class={`link ${disable === "projects" && "hide"}`}
    >Projects
    <ConsoleIcon />
  </a>
  <hr />
  <a href="https://github.com/metalpoch/" target="_blank">
    Github
    <GithubIcon />
  </a>
  <a href="https://www.threads.net/@keiberup" target="_blank">
    Threads
    <ThreadsIcon />
  </a>
  <a href="https://www.linkedin.com/in/keiber-urbila/" target="_blank">
    LinkedIn
    <LinkedinIcon />
  </a>
  <a href="https://www.instagram.com/keiberup/" target="_blank">
    Instagram
    <InstagramIcon />
  </a>
</nav>

<style is:inline>
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    justify-content: space-between;
    position: absolute;
    right: 0.5em;
    bottom: 3em;
    background-color: #000;
    padding: 1em;
  }

  @media (max-height: 400px) {
    a {
      font-size: 0.8em;
    }
  }
  a {
    display: flex;
    position: relative;
    gap: 5px;
    align-items: center;
    color: #fff;
    user-select: none;
    font-size: 1.25em;
    text-decoration: underline;
  }
  .hide {
    pointer-events: none;
    cursor: default;
    color: rgba(255, 255, 255, 0.25);
  }
  .hide path {
    fill: rgba(255, 255, 255, 0.25);
  }

  .link:hover svg {
    -webkit-animation: wobble-l 0.8s steps(2, end) both;
    animation: wobble-l 0.8s steps(2, end) both;
  }

  @keyframes wobble-l {
    0%,
    100% {
      -webkit-transform: translateY(0) rotate(0);
      transform: translateY(0) rotate(0);
      -webkit-transform-origin: 50% 50%;
      transform-origin: 50% 50%;
    }
    15% {
      -webkit-transform: translateY(-3.5px) rotate(-6deg);
      transform: translateY(-3.5px) rotate(-6deg);
    }
    30% {
      -webkit-transform: translateY(1.75px) rotate(6deg);
      transform: translateY(1.75px) rotate(6deg);
    }
    45% {
      -webkit-transform: translateY(-1.75px) rotate(-3.6deg);
      transform: translateY(-1.75px) rotate(-3.6deg);
    }
    60% {
      -webkit-transform: translateY(0.875px) rotate(2.4deg);
      transform: translateY(0.875px) rotate(2.4deg);
    }
    75% {
      -webkit-transform: translateY(-0.5px) rotate(-1.2deg);
      transform: translateY(-0.5px) rotate(-1.2deg);
    }
  }
</style>
