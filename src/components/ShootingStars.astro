<style>
  .stars {
    position: fixed;
    top: -32px;
    left: 15vw;
    display: flex;
    width: 100vw;
    height: 32px;
    justify-content: space-between;
  }
  .star {
    width: 32px;
    height: 32px;
    background: url("/assets/star.png");
    z-index: -100;
    animation: pulse calc(var(--i) * 100ms) steps(2) infinite,
      fall calc(var(--i) * 1s) -6s linear infinite;
  }

  @keyframes pulse {
    0% {
      background-position: 0;
    }
    100% {
      background-position: -64px;
    }
  }
  @keyframes fall {
    0% {
      transform: translateY(0) translateX(0) scale(0.2);
    }
    25% {
      transform: translateY(12.5vh) translateX(-5vw) scale(0.4);
    }
    50% {
      transform: translateY(25vh) translateX(-10vw) scale(0.3);
    }
    75% {
      transform: translateY(37.5vh) translateX(-15vw) scale(0.2);
    }
    100% {
      transform: translateY(70vh) translateX(-30vw) scale(0);
    }
  }
</style>

