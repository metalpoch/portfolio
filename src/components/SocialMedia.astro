---
interface Props {
  name: string;
  icon: string;
  url: string;
}
const { name, icon, url } = Astro.props;
---

<a href={url} target="_blank">
  <img title={name} alt={`${name} logo`} class="btn" src={icon} />
</a>

<style>
  .btn {
    width: 2.5em;
    padding: 5px;
    border-radius: 3px;
    background-color: #000;
  }

  .btn:hover {
    -webkit-animation: wobble-t 0.8s steps(2, end) both;
    animation: wobble-t 0.8s steps(2, end) both;
  }
  @keyframes wobble-t {
    0%,
    100% {
      -webkit-transform: translateX(0%);
      transform: translateX(0%);
      -webkit-transform-origin: 50% 50%;
      transform-origin: 50% 50%;
    }
    15% {
      -webkit-transform: translateX(-7.5px) rotate(6deg);
      transform: translateX(-7.5px) rotate(6deg);
    }
    30% {
      -webkit-transform: translateX(3.75px) rotate(-6deg);
      transform: translateX(3.75px) rotate(-6deg);
    }
    45% {
      -webkit-transform: translateX(-3.75px) rotate(3.6deg);
      transform: translateX(-3.75px) rotate(3.6deg);
    }
    60% {
      -webkit-transform: translateX(2.25px) rotate(-2.4deg);
      transform: translateX(2.25px) rotate(-2.4deg);
    }
    75% {
      -webkit-transform: translateX(-1.5px) rotate(1.2deg);
      transform: translateX(-1.5px) rotate(1.2deg);
    }
  }
</style>
