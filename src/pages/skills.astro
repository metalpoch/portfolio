---
import Layout from "../layouts/Layout.astro";
import Chat from "../components/Chat.astro";
import skillTech from "../components/constant/techSkills";
---

<Layout title="Keiber Urbila: Skills" view="skills">
  <main>
    <div class="chats">
      <Chat>
        <p>Deploy/Serverless<span>&rarr;</span></p>
        {
          skillTech.deploy.map(({ title, alt, src }) => (
            <img class="badge" title={title} alt={alt} src={src} />
          ))
        }
      </Chat>
      <Chat>
        <p>Bases De Datos<span>&rarr;</span></p>
        {
          skillTech.database.map(({ title, alt, src }) => (
            <img class="badge" title={title} alt={alt} src={src} />
          ))
        }
      </Chat>
      <Chat>
        <p>Backend<span>&rarr;</span></p>
        {
          skillTech.backend.map(({ title, alt, src }) => (
            <img class="badge" title={title} alt={alt} src={src} />
          ))
        }
      </Chat>
      <Chat>
        <p>Frontend<span>&rarr;</span></p>
        {
          skillTech.frontend.map(({ title, alt, src }) => (
            <img class="badge" title={title} alt={alt} src={src} />
          ))
        }
      </Chat>
    </div>

    <img
      class="player"
      alt="Keiber as pixel art"
      src="/assets/poch.png"
      class="img-profile"
    />
  </main>
</Layout>

<style>
  .badge {
    margin-left: 4px;
  }
  .chats {
    height: 50vh;
    overflow-y: auto;
    background-color: #fff;
    border-radius: 10px;
  }
  .chats::-webkit-scrollbar {
    width: 10px;
  }

  .chats::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 25px;
  }

  .chats::-webkit-scrollbar-thumb:hover {
    background: #444;
  }
</style>
