---
import Layout from "../layouts/Layout.astro";
import Chat from "../components/Chat.astro";
import skillTech from "../constant/techSkills";
---

<Layout title="Keiber Urbila: Skills" view="skills">
  <Chat>
    <p>Deploy/Serverless<span>&rarr;</span></p>
    {
      skillTech.deploy.map(({ title, alt, src }) => (
        <img class="badge" title={title} alt={alt} src={src} />
      ))
    }

    <p>Databases<span>&rarr;</span></p>
    {
      skillTech.database.map(({ title, alt, src }) => (
        <img class="badge" title={title} alt={alt} src={src} />
      ))
    }

    <p>Backend<span>&rarr;</span></p>
    {
      skillTech.backend.map(({ title, alt, src }) => (
        <img class="badge" title={title} alt={alt} src={src} />
      ))
    }

    <p>Frontend<span>&rarr;</span></p>
    {
      skillTech.frontend.map(({ title, alt, src }) => (
        <img class="badge" title={title} alt={alt} src={src} />
      ))
    }
  </Chat>
</Layout>

<style>
  .badge {
    margin-left: 4px;
  }
</style>
