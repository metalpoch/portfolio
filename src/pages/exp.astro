---
import Layout from "../layouts/Layout.astro";
import Chat from "../components/Chat.astro";
---

<Layout title="Keiber Urbila: EXP" view="exp">
  <Chat>
    <p>
      <span class="highlighter">Creador</span> y mantenedor de <span
        class="highlighter">Traffic Access</span
      >.
    </p>
    <p>
      Plataforma de <span class="highlighter">monitorización</span>,
      visualización y de <span class="highlighter">Análisis</span> de grandes cantidades
      de <span class="highlighter">datos</span> de tráfico para
      <span class="highlighter">importante</span> empresa de <span
        class="highlighter">telecomunicaciones</span
      >
      de Venezuela.
    </p>
    <video src="/assets/taccess.webm" autoplay muted loop width="100%"></video>
  </Chat>
</Layout>

<style>
  video {
    opacity: 0.8;
    filter: brightness(0.9);
  }
</style>
