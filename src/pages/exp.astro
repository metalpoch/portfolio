---
import Layout from "../layouts/Layout.astro";
import Chat from "../components/Chat.astro";
---

<Layout title="Keiber Urbila: EXP" view="exp">
  <Chat>
    <p>
      <span class="highlighter">Creator</span> and maintainer of <span
        class="highlighter">Traffic Access</span
      >.
    </p>
    <p>
      Platform for <span class="highlighter">monitoring</span>, visualization
      and <span class="highlighter">analysis</span> of large amounts of traffic <span
        class="highlighter">data</span
      > for an important<span class="highlighter">
        telecommunications company</span
      > in Venezuela.
    </p>
    <video src="/assets/taccess.webm" autoplay muted loop width="100%"></video>
  </Chat>
</Layout>

<style>
  video {
    width: 50%;
    margin-left: 0.8em;
  }
</style>
