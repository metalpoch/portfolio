---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Chat from "../components/Chat.astro";
import projectList from "../components/constant/projects";
---

<Layout title="Keiber Urbila: Projects" view="projects">
  <main>
    <Chat>
      {
        projectList.map((project) => (
          <>
            <a href={project.href} target="_blank">
              <h2>
                {project.title}
                <span>&rarr;</span>
              </h2>
              <p>{project.body}</p>
            </a>
            <hr />
          </>
        ))
      }
    </Chat>
    <img
      class="player"
      alt="Keiber as pixel art"
      src="/assets/poch.png"
      class="img-profile"
    />
  </main>
</Layout>

<style>
  a {
    text-decoration: none;
    color: #111;
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>
