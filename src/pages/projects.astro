---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout title="Keiber Urbila: Projects" view="projects">
  <main>
    <section>
      <Card
        href="https://podcast-t2.vercel.app/"
        title="Podcast"
        body="Landing Page para el servicio web de podcast para Spotify for Podcasters."
      />
      <br />
      <Card
        href="https://poch-pptls.vercel.app/"
        title="Piedra Papel Tijera Lagarto Spock"
        body="Guego inspirado en la serie de televisión The Big Bang Theory."
      />
      <br />
      <Card
        href="https://github.com/metalpoch/jump-snmp/"
        title="Jump SNMP"
        body="Realiza peticiones SNMP hacia un servidor remoto mediante SSH utilizando un servidor intermediario.."
      />
      <br />
      <Card
        href="https://github.com/metalpoch/Traffic-Dashboard/"
        title="Traffic Dashboard"
        body="Visualice la tendencias de las aplicaciones más utilizadas en algunas de las ciudades más importantes de Venezuela."
      />
    </section>
    <img
      class="player"
      alt="Keiber as pixel art"
      src="/assets/poch.png"
      class="img-profile"
    />
  </main>
</Layout>

<style>
  section {
    overflow-y: auto;
  }
</style>
